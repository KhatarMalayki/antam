                '.btn-primary',
                '.btn-success',
                'a[href*="booking"]',
                'button[onclick*="booking"]'
            ]
            
            for selector in selectors:
                try:
                    elements = driver.get_elements(selector)
                    if elements:
                        time_slots.extend(elements)
                        print(f"Found {len(elements)} elements with selector: {selector}")
                except:
                    continue
            
            if time_slots:
                print(f"Found {len(time_slots)} time slots!")
                
                # Try to click the first 3 available slots
                for i, slot in enumerate(time_slots[:3]):
                    try:
                        slot_text = slot.text.strip()
                        print(f"   Slot {i+1}: {slot_text}")
                        
                        if slot_text and ("Tersedia" in slot_text or any(f"{h:02d}:" in slot_text for h in range(8, 17))):
                            print(f"Clicking slot {i+1}: {slot_text}")
                            slot.click()
                            driver.sleep(3)
                            
                            # Check if we need to confirm booking
                            try:
                                confirm_buttons = driver.get_elements('button:contains("Konfirmasi"), button:contains("Ya"), button:contains("OK"), .btn-primary')
                                if confirm_buttons:
                                    print("Found confirmation button, clicking...")
                                    confirm_buttons[0].click()
                                    driver.sleep(3)
                                    break
                            except:
                                pass
                            
                    except Exception as e:
                        print(f"   Error clicking slot {i+1}: {e}")
                        continue
            else:
                print("No available time slots found")
                
                # Try to find and click on specific time buttons
                time_buttons = ['08:00', '09:00', '10:00', '11:00', '13:00', '14:00', '15:00', '16:00']
                for time_str in time_buttons:
                    try:
                        driver.click(f'button:contains("{time_str}")')
                        driver.sleep(2)
                        print(f"Clicked time: {time_str}")
                        break
                    except:
                        continue
                    
        except Exception as e:
            print(f"Error looking for time slots: {e}")
            
    except Exception as e:
        print(f"Error in boutique selection: {e}")
    
    driver.save_screenshot("final_result.png")
    
    return {
        "final_url": driver.current_url,
        "page_html": driver.page_html[:1000],
        "status": "completed"
    }


