def select_available_time_slot(driver):
    """Check and select available time slot from dropdown"""
    print("Checking available time slots...")
    try:
        # Check if we're on the right page with time slot dropdown
        if driver.current_url.startswith("https://antrean.logammulia.com/antrean?site="):
            driver.sleep(3)  # Wait for page to fully load
            
            # Look for time slot dropdown
            try:
                # Check if dropdown exists
                dropdown_present = driver.is_element_present('#wakda')
                if not dropdown_present:
                    print("No time slot dropdown found")
                    return False
                
                # Get all options from time slot dropdown specifically
                page_html = driver.page_html
                
                # Find the time slot dropdown (id="wakda") and its options
                # Look for the specific dropdown with id="wakda"
                wakda_pattern = r'<select[^>]*id="wakda"[^>]*>(.*?)</select>'
                wakda_match = re.search(wakda_pattern, page_html, re.DOTALL)
                
                if not wakda_match:
                    print("No time slot dropdown (wakda) found")
                    return False
                
                wakda_content = wakda_match.group(1)
                print(f"DEBUG: wakda dropdown content: {wakda_content[:500]}...")
                
                # Find all option elements in the wakda dropdown
                option_pattern = r'<option[^>]*value="([^"]*)"[^>]*>(.*?)</option>'
                options = re.findall(option_pattern, wakda_content, re.DOTALL)
                
                print(f"Found {len(options)} time slot options")
                
                # Debug: Print all options found
                for value, text in options:
                    if value and text.strip():
                        option_section = wakda_content.split(f'value="{value}"')[1].split('</option>')[0]
                        option_disabled = 'disabled' in option_section
                        print(f"  Option: '{text.strip()}' (value={value}, disabled={option_disabled})")
                
                available_slots = []
                for value, text in options:
                    if value and text.strip():  # Skip empty/default option
                        # Check if option is disabled or contains "Penuh"
                        option_section = wakda_content.split(f'value="{value}"')[1].split('</option>')[0]
                        option_disabled = 'disabled' in option_section
                        option_full = 'Penuh' in text or 'penuh' in text
                        
                        if not option_disabled and not option_full:
                            available_slots.append((value, text.strip()))
                            print(f"  Available: {text.strip()}")
                        else:
                            print(f"  Unavailable: {text.strip()}")
                
                if available_slots:
                    # Select the first available slot
                    slot_value, slot_text = available_slots[0]
                    print(f"Selecting available time slot: {slot_text}")
                    
                    # Use JavaScript to select the option
                    driver.run_js(f'document.getElementById("wakda").value = "{slot_value}";')
                    driver.sleep(2)
                    
                    # Look for submit/booking button
                    try:
                        submit_selectors = [
                            'button[type="submit"]',
                            '.btn-primary',
                            'button:contains("Daftar")',
                            'button:contains("Ambil")',
                            'button:contains("Submit")'
                        ]
                        
                        for selector in submit_selectors:
                            try:
                                submit_btn = driver.get_element(selector)
                                if submit_btn and not submit_btn.get_attribute('disabled'):
                                    submit_btn.click()
                                    print("Clicked submit button for time slot")
                                    driver.sleep(5)
                                    
                                    # Check for confirmation
                                    try:
                                        confirm_selectors = [
                                            'button:contains("Konfirmasi")',
                                            'button:contains("Ya")',
                                            'button:contains("OK")',
                                            '.btn-primary'
                                        ]
                                        
                                        for conf_selector in confirm_selectors:
                                            try:
                                                confirm_btn = driver.get_element(conf_selector)
                                                if confirm_btn:
                                                    confirm_btn.click()
                                                    print("Clicked confirmation button")
                                                    driver.sleep(3)
                                                    return True
                                            except:
                                                continue
                                    except:
                                        pass
                                    
                                    return True
                            except:
                                continue
                        
                        print("No submit button found or all buttons disabled")
                        return False
                        
                    except Exception as e:
                        print(f"Error clicking submit button: {e}")
                        return False
                else:
                    print("No available time slots found - all slots are either full or disabled")
                    return False
                    
            except Exception as e:
                print(f"Error processing time slot dropdown: {e}")
                return False
        else:
            print("Not on the correct page for time slot selection")
            return False
            
    except Exception as e:
        print(f"Error checking time slots: {e}")
        return False


