from botasaurus.browser import browser, Driver
import re
import json
import os
from datetime import datetime, timedelta


def solve_math_captcha(text):
    match = re.search(r'(\d+)\s+ditambah\s+(\d+)', text)
    if match:
        return int(match.group(1)) + int(match.group(2))
    
    match = re.search(r'(\d+)\s+dikurangi\s+(\d+)', text)
    if match:
        return int(match.group(1)) - int(match.group(2))
    
    match = re.search(r'(\d+)\s+dikali\s+(\d+)', text)
    if match:
        return int(match.group(1)) * int(match.group(2))
    
    match = re.search(r'Hitunglah\s+(\d+)\s+dikali\s+(\d+)', text)
    if match:
        return int(match.group(1)) * int(match.group(2))
    
    return None


def save_cookies(driver, filename="cookies.json"):
    """Save cookies to file with timestamp"""
    try:
        cookies = driver.get_cookies()
        cookie_data = {
            "cookies": cookies,
            "saved_at": datetime.now().isoformat(),
            "expires_at": (datetime.now() + timedelta(hours=24)).isoformat()  # Cookies valid for 24 hours
        }
        
        with open(filename, 'w') as f:
            json.dump(cookie_data, f, indent=2)
        
        print(f"Saved {len(cookies)} cookies to {filename}")
        return True
    except Exception as e:
        print(f"Error saving cookies: {e}")
        return False


def load_cookies(driver, filename="cookies.json"):
    """Load cookies from file if not expired"""
    try:
        if not os.path.exists(filename):
            print("No cookie file found")
            return False
        
        with open(filename, 'r') as f:
            cookie_data = json.load(f)
        
        # Check if cookies are expired
        expires_at = datetime.fromisoformat(cookie_data["expires_at"])
        if datetime.now() > expires_at:
            print("Cookies expired, need to login again")
            os.remove(filename)  # Remove expired cookie file
            return False
        
        # Load cookies using botasaurus method
        cookies = cookie_data["cookies"]
        try:
            # Try to set cookies using botasaurus approach
            for cookie in cookies:
                try:
                    # Use JavaScript to set cookies
                    if 'name' in cookie and 'value' in cookie:
                        cookie_str = f"{cookie['name']}={cookie['value']}"
                        if 'domain' in cookie:
                            cookie_str += f"; domain={cookie['domain']}"
                        if 'path' in cookie:
                            cookie_str += f"; path={cookie['path']}"
                        cookie_str += ";"
                        
                        driver.run_js(f'document.cookie = "{cookie_str}"')
                except Exception as e:
                    print(f"Error setting cookie: {e}")
                    continue
            
            print(f"Loaded {len(cookies)} cookies from {filename}")
            print(f"Cookies valid until: {expires_at.strftime('%Y-%m-%d %H:%M:%S')}")
            return True
            
        except Exception as e:
            print(f"Error loading cookies with botasaurus method: {e}")
            return False
        
    except Exception as e:
        print(f"Error loading cookies: {e}")
        return False


def is_logged_in(driver):
    """Check if user is already logged in"""
    try:
        driver.get("https://antrean.logammulia.com/users")
        driver.sleep(3)
        
        # Check if we're on users page (logged in) or redirected to login
        current_url = driver.current_url
        if "users" in current_url:
            print("Already logged in (detected from URL)")
            return True
        elif "login" in current_url:
            print("Not logged in (redirected to login page)")
            return False
        else:
            # Check page content for login indicators
            try:
                page_text = driver.get_text('body').lower()
                if "username" in page_text and "password" in page_text:
                    print("Not logged in (login form detected)")
                    return False
                elif "profile" in page_text or "logout" in page_text:
                    print("Already logged in (detected from page content)")
                    return True
                else:
                    print("Login status unclear, assuming not logged in")
                    return False
            except:
                print("Could not determine login status, assuming not logged in")
                return False
                
    except Exception as e:
        print(f"Error checking login status: {e}")
        return False


